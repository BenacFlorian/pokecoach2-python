APP_ENV=local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5442
POSTGRES_DB=pokecoach2
POSTGRES_USER=pokecoach_worker
POSTGRES_PASSWORD=
DB_CONNECT_TIMEOUT_SECONDS=5
ENABLE_DEMO_SEED=false
ANALYSIS_REGULATIONS=M-B,M-A,M-C
ANALYSIS_DEPLOYED_PHASES=A,C,B,D,synthesis
POKECOACH_ENGINE=stub
ANALYSIS_CHECKPOINT_ID=stub-bc-v1
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
LLM_INPUT_TOKEN_BUDGET=100000
LLM_OUTPUT_TOKEN_BUDGET=1200
LLM_TIMEOUT_SECONDS=45
DEEPINFRA_API_KEY=

# Budgets A/B/C/D (standard vs smoke) : src/pokecoach_python/simulation_budgets.py

# Moteur réel (plan 04b) — ne pas committer les poids
# POKECOACH_ENGINE=vgc_bench
# Profil modèle unique (chemin + architecture) — prioritaire sur VGC_CHECKPOINT_* :
# VGC_MODEL_PROFILE=/chemin/vers/vgc_model.yaml
# VGC_CHECKPOINT_PATH=/chemin/local/final.zip
# VGC_CHECKPOINT_SHA256=
# VGC_BRIDGE_PYTHON=
# Serveur Showdown : clone racine ../pokemon-showdown (pas engine-runtime/vendor/…)
# SHOWDOWN_SERVER_URL=ws://127.0.0.1:8090/showdown/websocket
# Délai preview (phase A) — subprocess bridge et attente team preview Showdown
# ANALYSIS_PREVIEW_TIMEOUT_SECONDS=90
# ENGINE_FIRST_TURN_TIMEOUT_SECONDS=120
# REGULATION_SHOWDOWN_MAP={"M-B":"gen9championsvgc2026regmb","M-A":"gen9championsvgc2026regma"}
# Tests CI bridge fixture : POKECOACH_BRIDGE_FIXTURE=1

# Tests d'intégration (base jetable migrée par pokecoach2-conception)
# TEST_DATABASE_URL=postgresql://pokecoach_worker:@127.0.0.1:5442/pokecoach2_test
# WORKER_DB_PASSWORD=
